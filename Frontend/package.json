{
  "name": "@ai-company/frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "2D 픽셀아트 메타버스 오피스 UI (React + Vite)",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "node tools/validate_office_map.mjs && node tools/validate_character_atlas.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sprites": "node tools/generate_sprites.mjs && node tools/build_reference_characters.mjs",
    "sprites:characters": "node tools/build_reference_characters.mjs",
    "map:validate": "node tools/validate_office_map.mjs",
    "sprites:validate": "node tools/validate_character_atlas.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
