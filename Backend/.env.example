# ── LLM ──────────────────────────────────────
# ollama | gemini | groq | claude | mock
#
# 기본값은 ollama 입니다. 내 PC 에서 도는 로컬 모델이라
# API 키도, 요청 한도도, 토큰 비용도 없습니다.
AI_PROVIDER=ollama

# ── Ollama (로컬) ────────────────────────────
#   1) 설치   https://ollama.com/download
#   2) 모델   ollama pull qwen3:8b
#   3) 확인   http://localhost:11434 → "Ollama is running"
#
# 모델 선택 기준 (VRAM/RAM 기준):
#   qwen3:8b    ~5GB  한국어가 가장 안정적입니다 (권장)
#   qwen3:4b    ~3GB  8GB RAM 노트북용. 품질은 조금 떨어집니다
#   gemma3:12b  ~8GB  여유가 있다면
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# 한 번의 호출을 기다려주는 시간. 첫 호출은 모델을 메모리에 올리느라 오래 걸립니다.
OLLAMA_TIMEOUT_MS=300000

# ── 클라우드 (선택) ──────────────────────────
# Google Gemini   https://aistudio.google.com/apikey
#   ⚠️ 결제가 연결된 프로젝트에서 발급하면 무료 한도가 0 이 됩니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq            https://console.groq.com/keys   (키가 gsk_ 로 시작)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 유료 Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# ── 호출 한도 ────────────────────────────────
# 비워두면 프로바이더별 기본값이 적용됩니다.
#   Ollama : 동시 1건 · 분당 무제한  ← 로컬은 직렬 처리라 1이 가장 빠릅니다
#   Gemini : 동시 2건 · 분당 10회
#   Groq   : 동시 1건 · 분당 4회
LLM_MAX_CONCURRENT=
LLM_REQUESTS_PER_MINUTE=
LLM_MAX_RETRIES=3
# 0이면 무제한. 기본값은 하루 200회 / 500,000토큰입니다.
LLM_DAILY_CALL_LIMIT=200
LLM_DAILY_TOKEN_LIMIT=500000
LLM_BUDGET_STATE_PATH=

# 설정하면 POST 등 변경 API에서 관리자 토큰을 요구합니다(최소 16자).
ADMIN_TOKEN=

# ── Obsidian 볼트 ────────────────────────────
# 볼트 폴더의 절대경로. 비워두면 저장소 루트의 ./vault 를 사용합니다.
# 예: C:\Users\PC_1M\Documents\MyVault
OBSIDIAN_VAULT=
OBSIDIAN_ROOT=AI Company

# 볼트 회상을 키워드 매칭 + 임베딩 하이브리드로 돌립니다. 채팅 프로바이더와 무관하게
# 항상 로컬 Ollama 를 씁니다: ollama pull nomic-embed-text (약 270MB)
# 서버가 안 떠 있거나 모델이 없으면 자동으로 키워드 전용 회상으로 대체됩니다.
VAULT_EMBEDDINGS_ENABLED=true
VAULT_EMBEDDING_MODEL=nomic-embed-text

# ── 서버 ─────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# 프로젝트 폴더·문서 날짜·LLM "오늘" 기준 (기본: Asia/Seoul)
APP_TIMEZONE=Asia/Seoul

# ── 워크플로 ─────────────────────────────────
# 교차검토 라운드 (0~3). 로컬 모델이 느리면 0 으로 두세요.
# 0 이면 호출 수가 절반 가까이 줄어듭니다 (대신 부서 간 상호 검증이 빠집니다).
FEEDBACK_ROUNDS=1
MAX_REWORK=1
SESSION_TTL_MS=3600000
# 비워두면 저장소 루트의 data/sessions.sqlite를 사용합니다.
SESSION_DATABASE_PATH=
AUTONOMOUS_WORK_INBOX_PATH=
